+                       u16 src_port = (le16_to_cpu(rd->rrd0) & IPQESS_RRD_PORT_ID_MASK) >> 12;
+
+                       if (src_port == rx_ring->ess->gmac1_port) {
+                               skb->dev = rx_ring->ess->netdev2;
+                               skb->protocol = eth_type_trans(skb, rx_ring->ess->netdev2);
+                               goto rx_demux_done;
+                       }
