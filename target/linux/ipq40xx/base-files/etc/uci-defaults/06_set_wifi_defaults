. /lib/functions.sh

board=$(board_name)

case "$board" in
trendnet,tew-829dru)
uci set wireless.default_radio0.ssid='OpenWrt-5g1'
uci set wireless.default_radio0.disabled='0'
uci set wireless.default_radio1.ssid='OpenWrt-2g'
uci set wireless.default_radio1.disabled='0'
uci set wireless.default_radio2.ssid='OpenWrt-5g2'
uci set wireless.default_radio2.disabled='0'
uci commit wireless
;;
esac

exit 0
